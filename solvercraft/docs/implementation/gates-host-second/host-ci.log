+pub fn gamma_q(a: f64, x: f64) -> Result<f64> {
+    if !a.is_finite() || a <= 0.0 || x.is_nan() || x < 0.0 {
+        return Err(err());
+    }
+    if x == f64::INFINITY {
+        return Ok(0.0);
+    }
+    if x < a + 1.0 {
+        return Ok(1.0 - gamma_p(a, x)?);
+    }
+    let factor = (-x + a * x.ln() - log_gamma(a)?).exp();
+    const TINY: f64 = 1e-300;
+    let mut b = x + 1.0 - a;
+    let mut c = 1.0 / TINY;
+    let mut d = 1.0 / b;
+    let mut h = d;
+    for n in 1..=20_000 {
+        let nf = n as f64;
+        let an = -nf * (nf - a);
+        b += 2.0;
+        d = an * d + b;
+        if d.abs() < TINY {
+            d = TINY.copysign(d);
+        }
+        c = b + an / c;
+        if c.abs() < TINY {
+            c = TINY.copysign(c);
+        }
+        d = 1.0 / d;
+        let delta = d * c;
+        h *= delta;
+        if (delta - 1.0).abs() < EPS {
+            return Ok((factor * h).clamp(0.0, 1.0));
+        }
+    }
+    Err(err())
 }
